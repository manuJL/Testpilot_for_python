# Copy to .env and fill in at least one provider.

# Groq — primary (free, fast). Get a key at https://console.groq.com/keys
GROQ_API_KEY=

# OpenRouter — fallback (free models use a ":free" suffix). https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Google Gemini Flash — fallback. https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Which provider to use first: groq | openrouter | gemini
TESTPILOT_PROVIDER=groq

# Model used for the fast GENERATE step (write tests)
TESTPILOT_GENERATE_MODEL=openai/gpt-oss-120b

# Model used for the stronger DIAGNOSE/PATCH steps
TESTPILOT_DIAGNOSE_MODEL=openai/gpt-oss-120b

